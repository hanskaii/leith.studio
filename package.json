{
	"name": "tanflare",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*",
		"tooling/*"
	],
	"scripts": {
		"check": "oxlint --config tooling/lint/oxlint.json --ignore-path tooling/lint/.oxlintignore apps/ packages/",
		"format": "oxfmt --config tooling/lint/.oxfmtrc.json --write apps/ packages/",
		"dev": "turbo dev",
		"build": "turbo build",
		"db:seed": "turbo -F @workspace/database db:seed",
		"db:push": "turbo -F @workspace/database db:push",
		"db:studio": "turbo -F @workspace/database db:studio",
		"db:generate": "turbo -F @workspace/database db:generate",
		"db:migrate": "turbo -F @workspace/database db:migrate",
		"db:migrate:prod": "NODE_ENV=production turbo -F @workspace/database db:migrate:prod",
		"secrets": "turbo secrets",
		"prepare": "husky"
	},
	"devDependencies": {
		"@workspace/core": "workspace:*",
		"@workspace/tsconfig": "workspace:*",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"oxfmt": "^0.41.0",
		"oxlint": "^1.60.0",
		"turbo": "^2.9.6",
		"typescript": "5.8.3"
	},
	"packageManager": "pnpm@10.33.0"
}
